@model ProductoFormViewModel
@{
    ViewData["Title"] = "Nuevo Producto";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Nuevo Producto</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label asp-for="Nombre" class="form-label fw-semibold"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Nombre del producto" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="IdCategoria" class="form-label fw-semibold"></label>
                            <select asp-for="IdCategoria" asp-items="ViewBag.Categorias" class="form-select">
                                <option value="0">-- Seleccione --</option>
                            </select>
                            <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PrecioVenta" class="form-label fw-semibold"></label>
                            <input asp-for="PrecioVenta" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="PrecioVenta" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CostoPromedio" class="form-label fw-semibold"></label>
                            <input asp-for="CostoPromedio" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="CostoPromedio" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="StockMaximo" class="form-label fw-semibold"></label>
                            <input asp-for="StockMaximo" class="form-control" type="number" />
                            <span asp-validation-for="StockMaximo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="ArchivoFoto" class="form-label fw-semibold"></label>
                            <input asp-for="ArchivoFoto" class="form-control" type="file" accept="image/*" />
                            <span asp-validation-for="ArchivoFoto" class="text-danger small"></span>
                        </div>
                    </div>

                    @* CHECKBOX PARA ESTADO (1 = Activo, 0 = Inactivo) *@
                    <div class="form-group form-check mt-3 mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="EstadoActivo" />
                        <label class="form-check-label fw-semibold" asp-for="EstadoActivo">Producto Activo</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Guardar Producto
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
