@model Producto
@{
    ViewData["Title"] = "Desactivar Producto";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Desactivar Producto</h4>
            </div>
            <div class="card-body">
                <p class="fs-5">¿Está seguro de desactivar el producto <strong>@Model.Nombre</strong>?</p>
                <p class="text-muted small">Esta operación realiza una baja lógica (Estado = Inactivo), conservando el historial en la base de datos.</p>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Categoría</dt>
                    <dd class="col-sm-8">@Model.IdCategoriaNavigation?.Nombre</dd>

                    <dt class="col-sm-4">Precio de Venta</dt>
                    <dd class="col-sm-8">S/ @Model.PrecioVenta.ToString("N2")</dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex justify-content-end gap-2">
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="IdProducto" />
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Confirmar Desactivación
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
