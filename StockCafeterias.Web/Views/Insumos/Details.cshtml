@model Insumo
@{
    ViewData["Title"] = "Detalle de Insumo";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="bi bi-box-seam me-2"></i>Detalle de Insumo #@Model.IdInsumo</h4>
                @if (Model.Estado == 1)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactivo</span>
                }
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Descripción</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Descripcion</dd>

                    <dt class="col-sm-4">Unidad de Medida</dt>
                    <dd class="col-sm-8">@Model.IdUnidadMedidaNavigation?.Nombre (@Model.IdUnidadMedidaNavigation?.Abreviatura)</dd>

                    <dt class="col-sm-4">Precio Unitario</dt>
                    <dd class="col-sm-8">S/ @Model.Precio.ToString("N2")</dd>

                    <dt class="col-sm-4">Stock Actual</dt>
                    <dd class="col-sm-8">@Model.StockActual.ToString("N2")</dd>

                    <dt class="col-sm-4">Stock Mínimo</dt>
                    <dd class="col-sm-8">@Model.StockMinimo.ToString("N2")</dd>

                    <dt class="col-sm-4">Registrado por</dt>
                    <dd class="col-sm-8">@Model.UsuarioRegistro (@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm"))</dd>

                    @if (!string.IsNullOrEmpty(Model.UsuarioUltModificacion))
                    {
                        <dt class="col-sm-4">Última Modificación</dt>
                        <dd class="col-sm-8">@Model.UsuarioUltModificacion (@Model.FechaUltModificacion?.ToString("dd/MM/yyyy HH:mm"))</dd>
                    }
                </dl>
            </div>
            <div class="card-footer bg-white d-flex justify-content-end gap-2">
                <a asp-action="Edit" asp-route-id="@Model.IdInsumo" class="btn btn-warning">
                    <i class="bi bi-pencil me-1"></i>Editar
                </a>
                <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
            </div>
        </div>
    </div>
</div>
