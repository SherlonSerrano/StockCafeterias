@model InsumoFormViewModel
@{
    ViewData["Title"] = "Editar Insumo";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Editar Insumo #@Model.IdInsumo</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="IdInsumo" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                            <input asp-for="Descripcion" class="form-control" />
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IdUnidadMedida" class="form-label fw-semibold"></label>
                            <select asp-for="IdUnidadMedida" asp-items="ViewBag.Unidades" class="form-select">
                                <option value="0">-- Seleccione --</option>
                            </select>
                            <span asp-validation-for="IdUnidadMedida" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Precio" class="form-label fw-semibold"></label>
                            <input asp-for="Precio" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="StockMinimo" class="form-label fw-semibold"></label>
                            <input asp-for="StockMinimo" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="StockMinimo" class="text-danger small"></span>
                        </div>
                    </div>

                    @* CHECKBOX PARA ESTADO (1 = Activo, 0 = Inactivo) *@
                    <div class="form-group form-check mt-3 mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="EstadoActivo" />
                        <label class="form-check-label fw-semibold" asp-for="EstadoActivo">Insumo Activo</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-warning text-dark fw-semibold">
                            <i class="bi bi-save me-1"></i>Actualizar Insumo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
