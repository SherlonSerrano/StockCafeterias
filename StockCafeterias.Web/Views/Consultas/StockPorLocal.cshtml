@model StockPorLocalConsultaViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Consulta: Stock por Local";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 mb-0"><i class="bi bi-shop text-info me-2"></i>Consulta de Stock por Local</h2>
        <small class="text-muted">Reporte basado en <code>sp_ReporteStockPorLocal</code> con filtros, paginación y gráfico estadístico</small>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-start border-4 border-primary">
            <div class="card-body">
                <div class="text-muted small">Total Registros</div>
                <div class="fs-3 fw-bold text-primary">@Model.TotalRegistros</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-start border-4 border-success">
            <div class="card-body">
                <div class="text-muted small">Stock Normal</div>
                <div class="fs-3 fw-bold text-success">@Model.TotalNormal</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-start border-4 border-warning">
            <div class="card-body">
                <div class="text-muted small">Stock Bajo</div>
                <div class="fs-3 fw-bold text-warning">@Model.TotalStockBajo</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-start border-4 border-danger">
            <div class="card-body">
                <div class="text-muted small">Sin Stock</div>
                <div class="fs-3 fw-bold text-danger">@Model.TotalSinStock</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="StockPorLocal" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Cafetería / Local</label>
                <select name="idLocal" asp-items="ViewBag.Locales" class="form-select">
                    <option value="">Todos los locales</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Buscar insumo</label>
                <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Nombre de insumo..." />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold d-block">Estado del Stock</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="estadoFiltro" id="stkTodos" value="todos" @(Model.EstadoFiltro == "todos" ? "checked" : "") />
                    <label class="form-check-label" for="stkTodos">Todos</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="estadoFiltro" id="stkBajo" value="bajo" @(Model.EstadoFiltro == "bajo" ? "checked" : "") />
                    <label class="form-check-label" for="stkBajo">Stock bajo</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="estadoFiltro" id="stkSin" value="sinstock" @(Model.EstadoFiltro == "sinstock" ? "checked" : "") />
                    <label class="form-check-label" for="stkSin">Sin stock</label>
                </div>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i>Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-table me-2"></i>Listado de Inventario (Página @Model.PaginaActual de @Model.TotalPaginas)
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Cafetería</th>
                            <th>Insumo</th>
                            <th class="text-end">Actual</th>
                            <th class="text-end">Mínimo</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Registros.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No hay registros para mostrar.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Registros)
                            {
                                <tr>
                                    <td>@item.Local</td>
                                    <td class="fw-semibold">@item.Insumo <small class="text-muted">(@item.Unidad)</small></td>
                                    <td class="text-end">@item.CantidadActual.ToString("N2")</td>
                                    <td class="text-end">@item.StockMinimo.ToString("N2")</td>
                                    <td class="text-center">
                                        @if (item.CantidadActual <= 0)
                                        {
                                            <span class="badge bg-danger">Sin stock</span>
                                        }
                                        else if (item.CantidadActual <= item.StockMinimo)
                                        {
                                            <span class="badge bg-warning text-dark">Stock bajo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Normal</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalPaginas > 1)
            {
                <div class="card-footer bg-white">
                    <nav aria-label="Paginación de stock por local">
                        <ul class="pagination pagination-sm justify-content-center mb-0">
                            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="StockPorLocal"
                                   asp-route-idLocal="@Model.IdLocal"
                                   asp-route-buscar="@Model.Buscar"
                                   asp-route-estadoFiltro="@Model.EstadoFiltro"
                                   asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                                    <a class="page-link" asp-action="StockPorLocal"
                                       asp-route-idLocal="@Model.IdLocal"
                                       asp-route-buscar="@Model.Buscar"
                                       asp-route-estadoFiltro="@Model.EstadoFiltro"
                                       asp-route-pagina="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                                <a class="page-link" asp-action="StockPorLocal"
                                   asp-route-idLocal="@Model.IdLocal"
                                   asp-route-buscar="@Model.Buscar"
                                   asp-route-estadoFiltro="@Model.EstadoFiltro"
                                   asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-bar-chart-fill me-2 text-primary"></i>Gráfico Estadístico por Cafetería
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="graficoStockLocal" style="max-height: 360px;"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const etiquetas = @Html.Raw(JsonSerializer.Serialize(Model.GraficoEtiquetas));
        const datosNormal = @Html.Raw(JsonSerializer.Serialize(Model.GraficoNormal));
        const datosBajo = @Html.Raw(JsonSerializer.Serialize(Model.GraficoStockBajo));
        const datosSin = @Html.Raw(JsonSerializer.Serialize(Model.GraficoSinStock));

        new Chart(document.getElementById('graficoStockLocal'), {
            type: 'bar',
            data: {
                labels: etiquetas,
                datasets: [
                    { label: 'Normal', data: datosNormal, backgroundColor: '#198754' },
                    { label: 'Stock bajo', data: datosBajo, backgroundColor: '#ffc107' },
                    { label: 'Sin stock', data: datosSin, backgroundColor: '#dc3545' }
                ]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom' } },
                scales: {
                    x: { stacked: true },
                    y: { stacked: true, beginAtZero: true, ticks: { precision: 0 } }
                }
            }
        });
    </script>
}
