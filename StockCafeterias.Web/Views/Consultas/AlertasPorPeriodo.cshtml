@model AlertasPorPeriodoConsultaViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Consulta: Alertas por Período";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 mb-0"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Consulta de Alertas por Período</h2>
        <small class="text-muted">Reporte basado en <code>sp_ReporteAlertasPorPeriodo</code> con filtros, paginación y gráfico comparativo</small>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-start border-4 border-primary">
            <div class="card-body">
                <div class="text-muted small">Total Alertas</div>
                <div class="fs-3 fw-bold text-primary">@Model.TotalRegistros</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-start border-4 border-warning">
            <div class="card-body">
                <div class="text-muted small">Stock Bajo</div>
                <div class="fs-3 fw-bold text-warning">@Model.TotalStockBajo</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-start border-4 border-danger">
            <div class="card-body">
                <div class="text-muted small">Sin Stock</div>
                <div class="fs-3 fw-bold text-danger">@Model.TotalSinStock</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-start border-4 border-success">
            <div class="card-body">
                <div class="text-muted small">Resueltas</div>
                <div class="fs-3 fw-bold text-success">@Model.TotalResueltas</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="AlertasPorPeriodo" method="get" class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label fw-semibold">Fecha Inicio</label>
                <input type="date" name="fechaInicio" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Fecha Fin</label>
                <input type="date" name="fechaFin" value="@Model.FechaFin.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Cafetería / Local</label>
                <select name="idLocal" asp-items="ViewBag.Locales" class="form-select">
                    <option value="">Todos los locales</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold d-block">Tipo de Alerta</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="tipoAlerta" id="alTodas" value="todos" @(Model.TipoAlerta == "todos" ? "checked" : "") />
                    <label class="form-check-label" for="alTodas">Todas</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="tipoAlerta" id="alBajo" value="B" @(Model.TipoAlerta == "B" ? "checked" : "") />
                    <label class="form-check-label" for="alBajo">Stock bajo</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="tipoAlerta" id="alSin" value="S" @(Model.TipoAlerta == "S" ? "checked" : "") />
                    <label class="form-check-label" for="alSin">Sin stock</label>
                </div>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-danger flex-fill">
                    <i class="bi bi-funnel me-1"></i>Consultar
                </button>
            </div>
        </form>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-table me-2"></i>Detalle de Alertas (Página @Model.PaginaActual de @Model.TotalPaginas)
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Fecha</th>
                            <th>Cafetería</th>
                            <th>Insumo</th>
                            <th class="text-center">Tipo</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Registros.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No se encontraron alertas en el período seleccionado.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Registros)
                            {
                                <tr>
                                    <td>@item.FechaAlerta.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@item.Local</td>
                                    <td class="fw-semibold">@item.Insumo</td>
                                    <td class="text-center">
                                        @if (item.TipoAlerta == "Sin stock")
                                        {
                                            <span class="badge bg-danger">Sin stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Stock bajo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.Resuelta)
                                        {
                                            <span class="badge bg-success">Resuelta</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Pendiente</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalPaginas > 1)
            {
                <div class="card-footer bg-white">
                    <nav aria-label="Paginación de alertas">
                        <ul class="pagination pagination-sm justify-content-center mb-0">
                            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="AlertasPorPeriodo"
                                   asp-route-fechaInicio="@Model.FechaInicio.ToString("yyyy-MM-dd")"
                                   asp-route-fechaFin="@Model.FechaFin.ToString("yyyy-MM-dd")"
                                   asp-route-idLocal="@Model.IdLocal"
                                   asp-route-tipoAlerta="@Model.TipoAlerta"
                                   asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                                    <a class="page-link" asp-action="AlertasPorPeriodo"
                                       asp-route-fechaInicio="@Model.FechaInicio.ToString("yyyy-MM-dd")"
                                       asp-route-fechaFin="@Model.FechaFin.ToString("yyyy-MM-dd")"
                                       asp-route-idLocal="@Model.IdLocal"
                                       asp-route-tipoAlerta="@Model.TipoAlerta"
                                       asp-route-pagina="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                                <a class="page-link" asp-action="AlertasPorPeriodo"
                                   asp-route-fechaInicio="@Model.FechaInicio.ToString("yyyy-MM-dd")"
                                   asp-route-fechaFin="@Model.FechaFin.ToString("yyyy-MM-dd")"
                                   asp-route-idLocal="@Model.IdLocal"
                                   asp-route-tipoAlerta="@Model.TipoAlerta"
                                   asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-graph-up me-2 text-danger"></i>Gráfico Estadístico (sp_ReporteAlertasPorPeriodo)
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="graficoAlertas" style="max-height: 360px;"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const locales = @Html.Raw(JsonSerializer.Serialize(Model.GraficoLocales));
        const stockBajo = @Html.Raw(JsonSerializer.Serialize(Model.GraficoStockBajo));
        const sinStock = @Html.Raw(JsonSerializer.Serialize(Model.GraficoSinStock));

        new Chart(document.getElementById('graficoAlertas'), {
            type: 'bar',
            data: {
                labels: locales,
                datasets: [
                    { label: 'Stock bajo', data: stockBajo, backgroundColor: '#ffc107' },
                    { label: 'Sin stock', data: sinStock, backgroundColor: '#dc3545' }
                ]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom' } },
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 } }
                }
            }
        });
    </script>
}
