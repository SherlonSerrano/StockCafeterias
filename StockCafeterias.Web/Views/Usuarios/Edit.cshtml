@model UsuarioFormViewModel
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Editar Usuario #@Model.IdUsuario</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="IdUsuario" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Nombres" class="form-label fw-semibold"></label>
                            <input asp-for="Nombres" class="form-control" />
                            <span asp-validation-for="Nombres" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Apellidos" class="form-label fw-semibold"></label>
                            <input asp-for="Apellidos" class="form-control" />
                            <span asp-validation-for="Apellidos" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NombreUsuario" class="form-label fw-semibold"></label>
                            <input asp-for="NombreUsuario" class="form-control bg-light" readonly />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold">Nueva Contraseña (opcional)</label>
                            <input asp-for="Password" class="form-control" placeholder="Dejar vacío para mantener la actual" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Dni" class="form-label fw-semibold"></label>
                            <input asp-for="Dni" class="form-control" maxlength="8" />
                            <span asp-validation-for="Dni" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Telefono" class="form-label fw-semibold"></label>
                            <input asp-for="Telefono" class="form-control" />
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IdRol" class="form-label fw-semibold"></label>
                            <select asp-for="IdRol" asp-items="ViewBag.Roles" class="form-select">
                                <option value="0">-- Seleccione --</option>
                            </select>
                            <span asp-validation-for="IdRol" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IdLocal" class="form-label fw-semibold"></label>
                            <select asp-for="IdLocal" asp-items="ViewBag.Locales" class="form-select">
                                <option value="">(Sin local asignado)</option>
                            </select>
                            <span asp-validation-for="IdLocal" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaNacimiento" class="form-label fw-semibold"></label>
                            <input asp-for="FechaNacimiento" class="form-control" type="date" />
                            <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaIngreso" class="form-label fw-semibold"></label>
                            <input asp-for="FechaIngreso" class="form-control" type="date" />
                            <span asp-validation-for="FechaIngreso" class="text-danger small"></span>
                        </div>
                    </div>

                    @* CHECKBOX PARA ESTADO (1 = Activo, 0 = Inactivo) *@
                    <div class="form-group form-check mt-3 mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="EstadoActivo" />
                        <label class="form-check-label fw-semibold" asp-for="EstadoActivo">Usuario Activo</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save me-1"></i>Actualizar Usuario
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
