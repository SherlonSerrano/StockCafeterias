@model Usuario
@{
    ViewData["Title"] = "Desactivar Usuario";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Desactivar Usuario</h4>
            </div>
            <div class="card-body">
                <p class="fs-5">¿Está seguro de desactivar al usuario <strong>@Model.NombreUsuario</strong>?</p>
                <p class="text-muted small">Esta operación realiza una baja lógica (Estado = Inactivo), conservando el historial en la base de datos.</p>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombres @Model.Apellidos</dd>

                    <dt class="col-sm-4">Rol</dt>
                    <dd class="col-sm-8">@Model.IdRolNavigation?.Nombre</dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex justify-content-end gap-2">
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="IdUsuario" />
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Confirmar Desactivación
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
